# ---------------------------------------------------------------------------
# Ohnivo - example environment
# Copy to .env (never commit .env). Web reads these at runtime; the bot reads
# the same file in Docker via docker-compose.
# ---------------------------------------------------------------------------

# Public app URL (no trailing slash). Used for OAuth redirects and Stripe URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS: keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used to mint short-lived user JWTs so RLS auth.uid() works. Optional in dev.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Discord ---------------------------------------------------------------
# OAuth2 application (scope: identify guilds)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# Bot user token, used by the worker and by presence checks on the web.
DISCORD_BOT_TOKEN=your-bot-token

# --- Session encryption ----------------------------------------------------
# 32+ random characters. Encrypts Discord tokens at rest (AES-256-GCM).
SESSION_SECRET=replace-with-a-long-random-string

# --- AI --------------------------------------------------------------------
# Leave blank to run the deterministic demo provider (no cost, same flow).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional NVIDIA API key.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
# auto | anthropic | nvidia | mock
AI_PROVIDER=auto
AI_RATE_LIMIT_PER_HOUR=20
ADMIN_DISCORD_IDS=
DEV_ADMIN_ENABLED=false

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Products and recurring prices are created automatically from packages/shared/src/plans.ts.

# --- Bot worker (only needed by apps/bot) ----------------------------------
# Defaults to NEXT_PUBLIC_SUPABASE_URL when omitted.
SUPABASE_URL=
WORKER_NAME=ohnivo-bot-local
POLL_INTERVAL_MS=2500
PRESENCE_SYNC_MS=300000
